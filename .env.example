# Fatos exatos: placar, tabela, rodada (football-data.org, competição BSA)
# Token gratuito em https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# Fatos exatos SÓ de jogo em andamento (api-sports.io, league 71). Opcional:
# sem ela, o placar de jogo ao vivo é o do football-data.org, que pode atrasar.
API_FOOTBALL_KEY=

# Geração de embeddings — Voyage AI (ver docs/tasks/03-vector-index.md)
VOYAGE_API_KEY=

# Geração de resposta final com citação (Claude)
ANTHROPIC_API_KEY=

# Índice vetorial (ver docs/tasks/03-vector-index.md)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=camisa10

# Cache de gravação/replay dos testes de integração (Anthropic/Voyage) — variável só de
# teste, não passa por src/config/env.ts. Ver tests/integration/support/llm-cassette.ts
# e README.md § "Rodar os testes". Valores: record | replay | (ausente = API real, padrão)
# LLM_CASSETTE=
